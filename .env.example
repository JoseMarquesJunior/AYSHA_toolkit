# Copie para .env (ignorado pelo git) e preencha.
ANTHROPIC_API_KEY=sk-ant-...

# IDs de modelo: consulte https://docs.claude.com/en/docs/about-claude/models
# MODEL_FAST: explicar e conversar. MODEL_DEEP: revisar, documentar e analisar AOIs.
# claude-fable-5-1 é o modelo mais capaz (raciocínio sempre ligado, profundidade via LLM_EFFORT_DEEP).
MODEL_FAST=claude-sonnet-5-5
MODEL_DEEP=claude-fable-5-1

# Esforço de raciocínio (opcional): low | medium | high | xhigh | max.
# Deixe vazio para modelos que não aceitam output_config.effort.
LLM_EFFORT_FAST=low
LLM_EFFORT_DEEP=high

# Orçamento de contexto (tokens estimados) e tamanho máximo da resposta (até 128000 com streaming).
# Se a resposta for cortada mesmo assim, o app pede continuação até LLM_MAX_CONTINUATIONS vezes (padrão 2).
MAX_CONTEXT_TOKENS=60000
MAX_OUTPUT_TOKENS=64000

# Idioma padrão das respostas: pt-BR | en | es
APP_LANGUAGE=pt-BR

# CSV de métricas por chamada (sem conteúdo do programa). Vazio desativa.
LLM_LOG_PATH=llm_calls.csv
