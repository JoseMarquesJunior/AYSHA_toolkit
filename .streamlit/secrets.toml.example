# Copie para .streamlit/secrets.toml (ignorado pelo git). Mesmas chaves do .env.example.
ANTHROPIC_API_KEY = "sk-ant-..."

# IDs de modelo: https://docs.claude.com/en/docs/about-claude/models
MODEL_FAST = "claude-sonnet-5-5"
MODEL_DEEP = "claude-opus-5-5"

LLM_EFFORT_FAST = "low"
LLM_EFFORT_DEEP = "high"
MAX_CONTEXT_TOKENS = "60000"
MAX_OUTPUT_TOKENS = "16000"
APP_LANGUAGE = "pt-BR"
LLM_LOG_PATH = "llm_calls.csv"
