# Copie para .streamlit/secrets.toml (ignorado pelo git). Mesmas chaves do .env.example.
ANTHROPIC_API_KEY = "sk-ant-..."

# IDs de modelo: https://docs.claude.com/en/docs/about-claude/models
MODEL_FAST = "claude-sonnet-5-5"
MODEL_DEEP = "claude-fable-5-1"

LLM_EFFORT_FAST = "low"
LLM_EFFORT_DEEP = "high"
MAX_CONTEXT_TOKENS = "60000"
MAX_OUTPUT_TOKENS = "64000"
LLM_MAX_CONTINUATIONS = "2"
APP_LANGUAGE = "pt-BR"
LLM_LOG_PATH = "llm_calls.csv"

# Códigos de acesso semeados a cada inicialização (disco efêmero na nuvem): CODIGO:dono:cota,...
ACCESS_CODES = "DEMO:Demo:20"
