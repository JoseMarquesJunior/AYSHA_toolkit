<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="P_Alm" Revision="1.0" Vendor="EB01 Lib" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false">
<Description><![CDATA[Alarme discreto genérico com severidade e necessidade de reconhecimento]]></Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false"/>
<Parameter Name="Inp" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true"><Description><![CDATA[Condição de alarme]]></Description></Parameter>
<Parameter Name="Cfg_Severity" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="false" Visible="false"><Description><![CDATA[Severidade 1-1000]]></Description>
<DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="500"/></DefaultData>
</Parameter>
<Parameter Name="Cfg_AckReqd" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false"/>
<Parameter Name="Cfg_Exists" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="1"/></DefaultData>
</Parameter>
<Parameter Name="Alm" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true"/>
</Parameters>
<LocalTags/>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[Alarme só é gerado se estiver habilitado na configuração]]></Comment><Text><![CDATA[XIC(Inp)XIC(Cfg_Exists)OTE(Alm);]]></Text></Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AI_Std" Revision="2.1" Vendor="EB01 Lib" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false">
<Description><![CDATA[Entrada analógica padrão: copia o valor escalado e gera alarme de range alto]]></Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false"/>
<Parameter Name="Inp_PV" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true"><Description><![CDATA[Valor bruto do cartão]]></Description></Parameter>
<Parameter Name="Cfg_RangeMin" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData>
</Parameter>
<Parameter Name="Cfg_RangeMax" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="100.0"/></DefaultData>
</Parameter>
<Parameter Name="Out_PV" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="true" Visible="true"><Description><![CDATA[Valor de processo em unidade de engenharia]]></Description></Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="AH_Alm" DataType="P_Alm" ExternalAccess="Read/Write"><Description><![CDATA[Alarme de range alto]]></Description></LocalTag>
<LocalTag Name="Wrk_T" DataType="TIMER" ExternalAccess="None"/>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[MOV(Inp_PV,Out_PV);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[GRT(Out_PV,Cfg_RangeMax)TON(Wrk_T,?,?);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[P_Alm(AH_Alm,Wrk_T.DN);]]></Text></Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="P_Motor" Revision="1.3" Vendor="EB01 Lib" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false">
<Description><![CDATA[Motor de velocidade fixa: comando liga/desliga, supervisão de retorno de marcha e falha com reset]]></Description>
<RevisionNote><![CDATA[1.3: tempo de retorno de marcha configurável (Cfg_FdbkT)]]></RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false"/>
<Parameter Name="Inp_Fdbk" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true"><Description><![CDATA[Retorno de marcha (contator fechado)]]></Description></Parameter>
<Parameter Name="Inp_Fault" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true"><Description><![CDATA[Falha externa (relé térmico)]]></Description></Parameter>
<Parameter Name="Cmd_Start" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true"><Description><![CDATA[Comando de partida da lógica]]></Description></Parameter>
<Parameter Name="Cmd_Stop" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true"><Description><![CDATA[Comando de parada (prioritário)]]></Description></Parameter>
<Parameter Name="Cmd_Reset" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true"><Description><![CDATA[Reset de falha]]></Description></Parameter>
<Parameter Name="Cfg_FdbkT" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false"><Description><![CDATA[Tempo (ms) para falha de retorno de marcha]]></Description>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="5000"/></DefaultData>
</Parameter>
<Parameter Name="Sts_Running" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true"><Description><![CDATA[Motor rodando (retorno confirmado)]]></Description></Parameter>
<Parameter Name="Sts_Fault" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true"><Description><![CDATA[Motor em falha]]></Description></Parameter>
<Parameter Name="Out_Run" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true"><Description><![CDATA[Saída para o contator]]></Description></Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Wrk_FdbkTmr" DataType="TIMER" ExternalAccess="None"><Description><![CDATA[Temporizador de retorno de marcha]]></Description></LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[Preset do temporizador vem da configuração da instância]]></Comment><Text><![CDATA[MOV(Cfg_FdbkT,Wrk_FdbkTmr.PRE);]]></Text></Rung>
<Rung Number="1" Type="N"><Comment><![CDATA[Saída liga com comando de partida, sem parada e sem falha]]></Comment><Text><![CDATA[XIC(Cmd_Start)XIO(Cmd_Stop)XIO(Sts_Fault)OTE(Out_Run);]]></Text></Rung>
<Rung Number="2" Type="N"><Comment><![CDATA[Se a saída está ligada e o contator não retornou dentro do tempo, falha]]></Comment><Text><![CDATA[XIC(Out_Run)XIO(Inp_Fdbk)TON(Wrk_FdbkTmr,?,?);]]></Text></Rung>
<Rung Number="3" Type="N"><Text><![CDATA[[XIC(Wrk_FdbkTmr.DN),XIC(Inp_Fault)]OTL(Sts_Fault);]]></Text></Rung>
<Rung Number="4" Type="N"><Text><![CDATA[XIC(Cmd_Reset)XIO(Inp_Fault)OTU(Sts_Fault);]]></Text></Rung>
<Rung Number="5" Type="N"><Text><![CDATA[XIC(Inp_Fdbk)OTE(Sts_Running);]]></Text></Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
