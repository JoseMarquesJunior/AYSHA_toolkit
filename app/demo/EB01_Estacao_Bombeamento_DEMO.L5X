<Controller Use="Target" Name="EB01_DEMO" ProcessorType="1756-L83E" MajorRev="35" MinorRev="11">
<Description><![CDATA[PROJETO DE DEMONSTRAÇÃO (sintético, não é uma planta real). Estação de bombeamento EB-01: dois conjuntos motobomba (B-101 e B-102) em rodízio, controle pelo nível do tanque TQ-101, proteções e alarmes. Contém problemas plantados de propósito para exercitar o diagnóstico.]]></Description>
<DataTypes>
<DataType Name="UDT_Receita" Family="NoFamily" Class="User">
<Description><![CDATA[Parâmetros de operação ajustáveis pelo HMI]]></Description>
<Members>
<Member Name="Nivel_Partida" DataType="REAL" Dimension="0" Radix="Float" Hidden="false"><Description><![CDATA[Nível (m) que parte a bomba líder]]></Description></Member>
<Member Name="Nivel_Parada" DataType="REAL" Dimension="0" Radix="Float" Hidden="false"><Description><![CDATA[Nível (m) que para o bombeamento]]></Description></Member>
<Member Name="Pressao_Minima" DataType="REAL" Dimension="0" Radix="Float" Hidden="false"><Description><![CDATA[Pressão mínima (bar) com bomba rodando]]></Description></Member>
</Members>
</DataType>
</DataTypes>
