<Description><![CDATA[Duração máxima da sirene sem reconhecimento]]></Description>
<Data Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="30000"/><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/><DataValueMember Name="DN" DataType="BOOL" Value="0"/></Structure></Data>
</Tag>
<Tag Name="T_Sem_Preset" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[Temporizador de teste deixado pelo comissionamento]]></Description>
<Data Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/><DataValueMember Name="DN" DataType="BOOL" Value="0"/></Structure></Data>
</Tag>
<Tag Name="C_Partidas_B101" TagType="Base" DataType="COUNTER" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[Contador de partidas da B-101 (manutenção preventiva)]]></Description>
<Data Format="Decorated"><Structure DataType="COUNTER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="500"/><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/></Structure></Data>
</Tag>
<Tag Name="C_Partidas_B102" TagType="Base" DataType="COUNTER" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[Contador de partidas da B-102 (manutenção preventiva)]]></Description>
<Data Format="Decorated"><Structure DataType="COUNTER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="500"/><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/></Structure></Data>
</Tag>
<Tag Name="Horimetro_B101" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Horímetro da B-101 em segundos]]></Description></Tag>
<Tag Name="Horimetro_B102" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Horímetro da B-102 em segundos]]></Description></Tag>
<Tag Name="Alm_Pressao_Baixa" TagType="Base" DataType="ALARM_DIGITAL" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[PAL-101 pressão de recalque baixa com bomba rodando]]></Description>
<Data Format="Decorated"><Structure DataType="ALARM_DIGITAL">
<DataValueMember Name="Severity" DataType="DINT" Radix="Decimal" Value="700"/>
<DataValueMember Name="MinDurationPRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="AckRequired" DataType="BOOL" Value="1"/>
<DataValueMember Name="Latched" DataType="BOOL" Value="1"/>
<DataValueMember Name="InAlarm" DataType="BOOL" Value="0"/>
</Structure></Data>
</Tag>
<Tag Name="Alm_Nivel_Alto" TagType="Base" DataType="ALARM_DIGITAL" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[LAH-101 nível alto do TQ-101 (chave LSH-101)]]></Description>
<Data Format="Decorated"><Structure DataType="ALARM_DIGITAL">
<DataValueMember Name="Severity" DataType="DINT" Radix="Decimal" Value="500"/>
<DataValueMember Name="MinDurationPRE" DataType="DINT" Radix="Decimal" Value="2000"/>
<DataValueMember Name="AckRequired" DataType="BOOL" Value="1"/>
<DataValueMember Name="Latched" DataType="BOOL" Value="0"/>
<DataValueMember Name="InAlarm" DataType="BOOL" Value="0"/>
</Structure></Data>
</Tag>
<Tag Name="Alm_Emergencia" TagType="Base" DataType="ALARM_DIGITAL" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated"><Structure DataType="ALARM_DIGITAL">
<DataValueMember Name="Severity" DataType="DINT" Radix="Decimal" Value="1000"/>
<DataValueMember Name="MinDurationPRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="AckRequired" DataType="BOOL" Value="1"/>
<DataValueMember Name="Latched" DataType="BOOL" Value="0"/>
<DataValueMember Name="InAlarm" DataType="BOOL" Value="0"/>
</Structure></Data>
</Tag>
<Tag Name="Alarme_Ativo" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Existe pelo menos um alarme ativo]]></Description></Tag>
<Tag Name="Alarme_Reconhecido" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Operador reconheceu os alarmes (silencia a sirene)]]></Description></Tag>
<Tag Name="Status_HMI" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Palavra de status para o HMI (bit 0 bombeando, bit 1 alarme)]]></Description></Tag>
<Tag Name="Reserva_01" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Reserva]]></Description></Tag>
<Tag Name="Reserva_02" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"/>
</Tags>
<Programs>
<Program Name="Bombeamento" TestEdits="false" MainRoutineName="Principal" Disabled="false" UseAsFolder="false">
<Description><![CDATA[Controle da estação de bombeamento EB-01: leitura de entradas, partida/parada das bombas por nível com rodízio, intertravamentos, alarmes e saídas físicas.]]></Description>
<Tags>
<Tag Name="Bombeamento_Ativo" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Ciclo de bombeamento em andamento (selado entre nível de partida e de parada)]]></Description></Tag>
<Tag Name="Lider_B101" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[B-101 é a bomba líder neste ciclo]]></Description></Tag>
<Tag Name="Lider_B102" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[B-102 é a bomba líder neste ciclo]]></Description></Tag>
<Tag Name="Pedido_Segunda_Bomba" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Nível alto persistente: pede a bomba de apoio]]></Description></Tag>
<Tag Name="Ons_Rodizio" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Bit de borda do rodízio]]></Description></Tag>
<Tag Name="Bloqueio_Emergencia" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Emergência acionada: bloqueia válvula e bombas]]></Description></Tag>
<Tag Name="B_101_Run" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[B-101 saída da AOI para o contator K1]]></Description></Tag>
<Tag Name="B_102_Run" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[B-102 saída da AOI para o contator K2]]></Description></Tag>
</Tags>
<Routines>
<Routine Name="Principal" Type="RLL">
<Description><![CDATA[Rotina principal: ordem de execução das sub-rotinas a cada varredura]]></Description>
<RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[1. Leitura e escala das entradas físicas]]></Comment><Text><![CDATA[JSR(Entradas,0);]]></Text></Rung>
<Rung Number="1" Type="N"><Comment><![CDATA[2. Partida e parada das bombas por nível, com rodízio]]></Comment><Text><![CDATA[JSR(Partida_Bombas,0);]]></Text></Rung>
<Rung Number="2" Type="N"><Comment><![CDATA[3. Intertravamentos e proteções]]></Comment><Text><![CDATA[JSR(Intertravamentos,0);]]></Text></Rung>
<Rung Number="3" Type="N"><Comment><![CDATA[4. Alarmes, sirene e lâmpada de falha]]></Comment><Text><![CDATA[JSR(Alarmes,0);]]></Text></Rung>
<Rung Number="4" Type="N"><Comment><![CDATA[5. Blocos de motor e saídas físicas]]></Comment><Text><![CDATA[JSR(Saidas,0);]]></Text></Rung>
</RLLContent>
</Routine>
<Routine Name="Entradas" Type="RLL">
<Description><![CDATA[Mapeia as entradas físicas dos cartões para tags do programa e escala as analógicas]]></Description>
<RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[Entradas digitais do cartão 1756-IB16 no slot 2]]></Comment><Text><![CDATA[XIC(Local:2:I.Data.0)OTE(LSH_101);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[XIC(Local:2:I.Data.1)OTE(LSL_101);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[XIC(Local:2:I.Data.2)OTE(B_101_Fdbk);]]></Text></Rung>
<Rung Number="3" Type="N"><Text><![CDATA[XIC(Local:2:I.Data.3)OTE(B_102_Fdbk);]]></Text></Rung>
<Rung Number="4" Type="N"><Text><![CDATA[XIC(Local:2:I.Data.4)OTE(B_101_Term);]]></Text></Rung>
<Rung Number="5" Type="N"><Text><![CDATA[XIC(Local:2:I.Data.5)OTE(B_102_Term);]]></Text></Rung>
<Rung Number="6" Type="N"><Text><![CDATA[XIC(Local:2:I.Data.6)OTE(Emergencia_OK);]]></Text></Rung>
<Rung Number="7" Type="N"><Text><![CDATA[XIC(Local:2:I.Data.7)OTE(Seletor_Remoto);]]></Text></Rung>
<Rung Number="8" Type="N"><Comment><![CDATA[Entradas analógicas: cópia do bruto e escala/alarme de range pela AOI AI_Std]]></Comment><Text><![CDATA[MOV(Local:4:I.Ch0.Data,LIT_101_Raw)AI_Std(LIT_101,LIT_101_Raw,LIT_101_PV);]]></Text></Rung>
<Rung Number="9" Type="N"><Text><![CDATA[MOV(Local:4:I.Ch1.Data,PIT_101_Raw)AI_Std(PIT_101,PIT_101_Raw,PIT_101_PV);]]></Text></Rung>
<Rung Number="10" Type="N"><Comment><![CDATA[A vazão é tratada em FBD]]></Comment><Text><![CDATA[JSR(Vazao_FBD,0);]]></Text></Rung>
<Rung Number="11" Type="N"><Text><![CDATA[AI_Std(FIT_101,FIT_101_Raw,FIT_101_PV);]]></Text></Rung>
</RLLContent>
</Routine>
<Routine Name="Partida_Bombas" Type="RLL">
<Description><![CDATA[Partida e parada dos conjuntos motobomba B-101 e B-102 em função do nível do TQ-101, com rodízio de bomba líder e atraso para a bomba de apoio]]></Description>
<RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[Ciclo de bombeamento: inicia quando o nível passa do setpoint de partida ou o operador aperta PARTIR no HMI. Exige seletor em Remoto e emergência OK. Sela até o nível cair abaixo do setpoint de parada ou o operador apertar PARAR.]]></Comment><Text><![CDATA[[GEQ(LIT_101_PV,Receita.Nivel_Partida) ,XIC(Partida_Auto) ,XIC(Bombeamento_Ativo) ]XIC(Seletor_Remoto)XIC(Emergencia_OK)XIO(Parada_Auto)GRT(LIT_101_PV,Receita.Nivel_Parada)OTE(Bombeamento_Ativo);]]></Text></Rung>
<Rung Number="1" Type="N"><Comment><![CDATA[Rodízio: a cada fim de ciclo (borda de descida do bombeamento) troca a bomba líder, para equalizar as horas de operação.]]></Comment><Text><![CDATA[XIO(Bombeamento_Ativo)ONS(Ons_Rodizio)XOR(Rodizio_Bomba,1,Rodizio_Bomba);]]></Text></Rung>
<Rung Number="2" Type="N"><Comment><![CDATA[Seleção da bomba líder conforme o rodízio (0 = B-101, 1 = B-102).]]></Comment><Text><![CDATA[XIC(Bombeamento_Ativo)EQU(Rodizio_Bomba,0)OTE(Lider_B101);]]></Text></Rung>
<Rung Number="3" Type="N"><Text><![CDATA[XIC(Bombeamento_Ativo)EQU(Rodizio_Bomba,1)OTE(Lider_B102);]]></Text></Rung>
<Rung Number="4" Type="N"><Comment><![CDATA[Bomba de apoio: se, com o ciclo ativo, a chave de nível alto LSH-101 permanecer atuada por 10 s, a bomba líder não está vencendo a afluência.]]></Comment><Text><![CDATA[XIC(Bombeamento_Ativo)XIC(LSH_101)TON(T_Partida_B102,?,?);]]></Text></Rung>
<Rung Number="5" Type="N"><Comment><![CDATA[Pedido da segunda bomba após o atraso.]]></Comment><Text><![CDATA[XIC(T_Partida_B102.DN)OTE(Pedido_Segunda_Bomba);]]></Text></Rung>
<Rung Number="6" Type="N"><Comment><![CDATA[Pedido de partida de cada bomba: parte se for a líder ou se houver pedido de segunda bomba, desde que o relé térmico não esteja atuado.]]></Comment><Text><![CDATA[[XIC(Lider_B101) ,XIC(Pedido_Segunda_Bomba) ]XIO(B_101_Term)OTE(B_101_Cmd);]]></Text></Rung>
<Rung Number="7" Type="N"><Text><![CDATA[[XIC(Lider_B102) ,XIC(Pedido_Segunda_Bomba) ]XIO(B_102_Term)OTE(B_102_Cmd);]]></Text></Rung>
<Rung Number="8" Type="N"><Comment><![CDATA[Contagem de partidas para a manutenção preventiva (preset 500 partidas).]]></Comment><Text><![CDATA[XIC(B_101_Cmd)CTU(C_Partidas_B101,?,?);]]></Text></Rung>
<Rung Number="9" Type="N"><Text><![CDATA[XIC(B_102_Cmd)CTU(C_Partidas_B102,?,?);]]></Text></Rung>
</RLLContent>
</Routine>
<Routine Name="Intertravamentos" Type="RLL">
<Description><![CDATA[Proteções: nível baixo, emergência, válvula de recalque e supervisão de pressão]]></Description>
<RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[Nível baixo (LSL-101): desliga a bomba de apoio imediatamente para evitar cavitação. ATENÇÃO: usa OTU sobre uma tag escrita por OTE em Partida_Bombas.]]></Comment><Text><![CDATA[XIC(LSL_101)OTU(B_102_Cmd);]]></Text></Rung>
<Rung Number="1" Type="N"><Comment><![CDATA[Emergência acionada (contato NF aberto) gera bloqueio geral.]]></Comment><Text><![CDATA[XIO(Emergencia_OK)OTE(Bloqueio_Emergencia);]]></Text></Rung>
<Rung Number="2" Type="N"><Comment><![CDATA[A válvula de recalque XV-101 abre quando qualquer bomba está rodando e não há bloqueio.]]></Comment><Text><![CDATA[[XIC(B_101.Sts_Running) ,XIC(B_102.Sts_Running) ]XIO(Bloqueio_Emergencia)OTE(XV_101_Abrir);]]></Text></Rung>
<Rung Number="3" Type="N"><Comment><![CDATA[Pressão de recalque abaixo da mínima com bomba rodando por 15 s: bomba sem escorva ou válvula fechada.]]></Comment><Text><![CDATA[[XIC(B_101.Sts_Running) ,XIC(B_102.Sts_Running) ]LES(PIT_101_PV,Receita.Pressao_Minima)TON(T_Pressao_Baixa,?,?);]]></Text></Rung>
<Rung Number="4" Type="N"><Text><![CDATA[XIC(Bloqueio_Emergencia)TON(T_Sem_Preset,?,?);]]></Text></Rung>
</RLLContent>
</Routine>
<Routine Name="Alarmes" Type="RLL">
<Description><![CDATA[Alarmes nativos (ALMD), consolidação, sirene com reconhecimento e lâmpada de falha]]></Description>
<RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[Alarmes digitais nativos com reset pelo botão do HMI]]></Comment><Text><![CDATA[ALMD(Alm_Pressao_Baixa,T_Pressao_Baixa.DN,0,Reset_Alarmes,0,0);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[ALMD(Alm_Nivel_Alto,LSH_101,0,Reset_Alarmes,0,0);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[ALMD(Alm_Emergencia,Bloqueio_Emergencia,0,Reset_Alarmes,0,0);]]></Text></Rung>
<Rung Number="3" Type="N"><Comment><![CDATA[Alarme geral: qualquer alarme nativo em estado de alarme ou falha de motor]]></Comment><Text><![CDATA[[XIC(Alm_Pressao_Baixa.InAlarm) ,XIC(Alm_Nivel_Alto.InAlarm) ,XIC(Alm_Emergencia.InAlarm) ,XIC(B_101.Sts_Fault) ,XIC(B_102.Sts_Fault) ]OTE(Alarme_Ativo);]]></Text></Rung>
<Rung Number="4" Type="N"><Comment><![CDATA[Sirene toca enquanto houver alarme não reconhecido, no máximo 30 s]]></Comment><Text><![CDATA[XIC(Alarme_Ativo)XIO(Alarme_Reconhecido)TON(T_Sirene,?,?);]]></Text></Rung>
<Rung Number="5" Type="N"><Text><![CDATA[XIC(T_Sirene.TT)OTE(Sirene);]]></Text></Rung>
<Rung Number="6" Type="N"><Comment><![CDATA[Reconhecimento sela até os alarmes sumirem]]></Comment><Text><![CDATA[XIC(Reset_Alarmes)XIC(Alarme_Ativo)OTL(Alarme_Reconhecido);]]></Text></Rung>
<Rung Number="7" Type="N"><Text><![CDATA[XIO(Alarme_Ativo)OTU(Alarme_Reconhecido);]]></Text></Rung>
<Rung Number="8" Type="N"><Text><![CDATA[XIC(Alarme_Ativo)OTE(Lamp_Falha);]]></Text></Rung>
<Rung Number="9" Type="N"><Comment><![CDATA[Palavra de status para o HMI]]></Comment><Text><![CDATA[XIC(Bombeamento_Ativo)OTE(Status_HMI.0)XIC(Alarme_Ativo)OTE(Status_HMI.1);]]></Text></Rung>
</RLLContent>
</Routine>
<Routine Name="Saidas" Type="RLL">
<Description><![CDATA[Blocos de motor (P_Motor) e mapeamento para as saídas físicas do cartão do slot 3]]></Description>
<RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[Bloco de motor da B-101: comando, parada pelo HMI, reset de falha pelo botão de alarmes]]></Comment><Text><![CDATA[P_Motor(B_101,B_101_Fdbk,B_101_Term,B_101_Cmd,Parada_Auto,Reset_Alarmes,B_101_Run);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[P_Motor(B_102,B_102_Fdbk,B_102_Term,B_102_Cmd,Parada_Auto,Reset_Alarmes,B_102_Run);]]></Text></Rung>
<Rung Number="2" Type="N"><Comment><![CDATA[Saídas físicas 1756-OB16E slot 3]]></Comment><Text><![CDATA[XIC(B_101_Run)XIO(Bloqueio_Emergencia)OTE(Local:3:O.Data.0);]]></Text></Rung>
<Rung Number="3" Type="N"><Text><![CDATA[XIC(B_102_Run)XIO(Bloqueio_Emergencia)OTE(Local:3:O.Data.1);]]></Text></Rung>
<Rung Number="4" Type="N"><Text><![CDATA[XIC(Sirene)OTE(Local:3:O.Data.2);]]></Text></Rung>
<Rung Number="5" Type="N"><Text><![CDATA[XIC(Lamp_Falha)OTE(Local:3:O.Data.3);]]></Text></Rung>
<Rung Number="6" Type="N"><Text><![CDATA[XIC(XV_101_Abrir)OTE(Local:3:O.Data.4);]]></Text></Rung>
</RLLContent>
</Routine>
<Routine Name="Vazao_FBD" Type="FBD">
<Description><![CDATA[Leitura da vazão FIT-101 em diagrama de blocos]]></Description>
<FBDContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape">
<Sheet Number="1">
<IRef ID="0" X="100" Y="100" Operand="Local:4:I.Ch2.Data" HideDesc="false"/>
<ORef ID="1" X="300" Y="100" Operand="FIT_101_Raw" HideDesc="false"/>
<IRef ID="2" X="100" Y="260" Operand="Reserva_02" HideDesc="false"/>
<Wire FromID="0" ToID="1"/>
</Sheet>
</FBDContent>
</Routine>
<Routine Name="Teste_Comissionamento" Type="RLL">
<Description><![CDATA[Rotina de testes usada no comissionamento (2024). Deixada no projeto, sem JSR.]]></Description>
<RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[AFI()XIC(Partida_Auto)OTE(Sirene);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[AFI()MOV(3.0,LIT_101_Raw);]]></Text></Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Utilidades" TestEdits="false" MainRoutineName="Horimetros" Disabled="false" UseAsFolder="false">
<Description><![CDATA[Horímetros das bombas, executados em tarefa periódica de 1 s]]></Description>
<Tags/>
<Routines>
<Routine Name="Horimetros" Type="RLL">
<Description><![CDATA[Incrementa 1 s nos horímetros enquanto cada bomba estiver rodando]]></Description>
<RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[A tarefa T_1000ms roda a cada 1 s, então cada varredura soma 1 segundo]]></Comment><Text><![CDATA[XIC(B_101.Sts_Running)ADD(Horimetro_B101,1,Horimetro_B101);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[XIC(B_102.Sts_Running)ADD(Horimetro_B102,1,Horimetro_B102);]]></Text></Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Simulacao" TestEdits="false" MainRoutineName="Sim_Processo" Disabled="false" UseAsFolder="false">
<Description><![CDATA[Simulação de processo para testes em bancada. Não deve estar agendado em produção.]]></Description>
<Tags/>
<Routines>
<Routine Name="Sim_Processo" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[XIO(B_101_Cmd)XIO(B_102_Cmd)ADD(LIT_101_Raw,0.01,LIT_101_Raw);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[XIC(B_101_Cmd)OTE(B_101_Fdbk);]]></Text></Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<ScheduledPrograms><ScheduledProgram Name="Bombeamento"/></ScheduledPrograms>
</Task>
<Task Name="T_1000ms" Type="PERIODIC" Rate="1000" Priority="12" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<ScheduledPrograms><ScheduledProgram Name="Utilidades"/></ScheduledPrograms>
</Task>
</Tasks>
</Controller>
</RSLogix5000Content>
