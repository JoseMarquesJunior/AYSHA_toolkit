<Routines>
<Routine Name="MainRoutine" Type="RLL">
<Description><![CDATA[Rotina principal]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Partida do motor]]></Comment>
<Text><![CDATA[XIC(Start)XIO(Stop)OTE(Motor);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Text><![CDATA[XIC(StartAlias)OTE(Motor);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[Timers sem preset]]></Comment>
<Text><![CDATA[XIC(Motor)TON(T1,?,?)TON(Tank1.FillTimer,?,?)TOF(T2,0,0);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[Chamada de sub-rotina com parâmetros]]></Comment>
<Text><![CDATA[JSR(Called,1,Setpoint,LocalFlag);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[Ramos aninhados]]></Comment>
<Text><![CDATA[XIC(Start)[XIO(Stop)[OTE(Lamp) ,XIC(T2.DN)OTL(Pump) ] ,MOV(Setpoint,Tank1.Level) ];]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[AOI, string com vírgula e MSG]]></Comment>
<Text><![CDATA[MyAoi(MyAoi1,Tank1.Level,AoiOut,AoiIO)CONCAT(StrTag,'a,b',StrTag)MSG(Msg1);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment><![CDATA[JSR para rotina inexistente]]></Comment>
<Text><![CDATA[JSR(Missing,0);]]></Text>
</Rung>
<Rung Number="7" Type="N">
<Comment><![CDATA[Latch misturado com OTE]]></Comment>
<Text><![CDATA[XIC(Stop)OTE(Pump)OTU(Pump);]]></Text>
</Rung>
<Rung Number="8" Type="N">
<Comment><![CDATA[Expressão, índice e GSV]]></Comment>
<Text><![CDATA[CPT(WriteOnly,Arr[Idx]*2+Tank1.Level)CTU(Counter1,?,?)GSV(PROGRAM,THIS,LASTSCANTIME,Arr[0])GRT(Setpoint,ConstTag);]]></Text>
</Rung>
<Rung Number="9" Type="N">
<Comment><![CDATA[Rung propositalmente quebrado]]></Comment>
<Text><![CDATA[XIC(Start OTE(Lamp);]]></Text>
</Rung>
<Rung Number="10" Type="N">
<Comment><![CDATA[Referência a outro programa e tag inexistente]]></Comment>
<Text><![CDATA[XIC(\Unscheduled.Remote)OTE(Lamp2);]]></Text>
</Rung>
<Rung Number="11" Type="N">
<Comment><![CDATA[Instrução desconhecida]]></Comment>
<Text><![CDATA[FOO(Setpoint);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Called" Type="ST">
<STContent>
<Line Number="0"><![CDATA[// Rotina ST chamada por JSR]]></Line>
<Line Number="1"><![CDATA[IF Start AND NOT Stop THEN]]></Line>
<Line Number="2"><![CDATA[    Tank1.Level := Setpoint * 2.0; (* comentário de bloco *)]]></Line>
<Line Number="3"><![CDATA[    JSR(StCalled, 0);]]></Line>
<Line Number="4"><![CDATA[END_IF;]]></Line>
<Line Number="5"><![CDATA[StrTag := 'Start AND Stop';]]></Line>
<Line Number="6"><![CDATA[MyAoi(MyAoi1, Setpoint, AoiOut, AoiIO);]]></Line>
</STContent>
</Routine>
<Routine Name="StCalled" Type="FBD">
<FBDContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape">
<Sheet Number="1">
<IRef ID="0" X="100" Y="100" Operand="Setpoint" HideDesc="false"/>
<ORef ID="1" X="300" Y="100" Operand="Lamp" HideDesc="false"/>
<Block Type="SCL" ID="2" X="200" Y="100" Operand="Scl1" VisiblePins="In Out" HideDesc="false"/>
<Wire FromID="0" ToID="2" ToParam="In"/>
<Wire FromID="2" FromParam="Out" ToID="1"/>
</Sheet>
</FBDContent>
</Routine>
<Routine Name="Orphan" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text><![CDATA[NOP();]]></Text>
</Rung>
</RLLContent>
</Routine>
