<Description><![CDATA[Rotina de falha]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Nada a fazer]]></Comment>
<Text><![CDATA[NOP();]]></Text>
</Rung>
</RLLContent>
</Routine>
