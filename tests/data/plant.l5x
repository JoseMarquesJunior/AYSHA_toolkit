<Programs>
<Program Name="Main" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[Entrada analógica 1]]></Comment><Text><![CDATA[MOV(Local:4:I.Ch0.Data,LIT_100_Raw)AI_Std(LIT_100,LIT_100_Raw,LIT_100_PV);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[AI_Std(LIT_200,LIT_200_Raw,LIT_200_PV);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[XIC(Local:3:I.Data.1)OTE(ZSH_100);]]></Text></Rung>
<Rung Number="3" Type="N"><Text><![CDATA[ALMD(DigAlm1,ZSH_100,0,0,0,0);]]></Text></Rung>
<Rung Number="4" Type="N"><Text><![CDATA[XV_Std(XV_100,ZSH_100,XV_100_Out);]]></Text></Rung>
<Rung Number="5" Type="N"><Text><![CDATA[XIC(XV_100_Out)OTE(Local:4:O.Ch0.Data);]]></Text></Rung>
<Rung Number="6" Type="N"><Text><![CDATA[TON(T_Main,?,?);]]></Text></Rung>
<Rung Number="7" Type="N"><Text><![CDATA[JSR(Scaling,0);]]></Text></Rung>
</RLLContent>
</Routine>
<Routine Name="Scaling" Type="FBD">
<FBDContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape">
<Sheet Number="1">
<IRef ID="0" X="100" Y="100" Operand="Local:4:I.Ch1.Data" HideDesc="false"/>
<ORef ID="1" X="300" Y="100" Operand="LIT_200_Raw" HideDesc="false"/>
<Wire FromID="0" ToID="1"/>
</Sheet>
</FBDContent>
</Routine>
<Routine Name="Spare" Type="RLL">
